# Repo-wide ignores. Team folders may add their own .gitignore for
# anything specific to their tooling.

# macOS / Windows
.DS_Store
._*
Thumbs.db

# Editors / IDEs
.vscode/
.idea/
*.swp

# Secrets — never commit these
.env
.env.*
*.pem
*.key
credentials.json

# Python / Jupyter
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/

# LaTeX build artifacts
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.lof
*.log
*.lot
*.out
*.synctex.gz
*.toc
